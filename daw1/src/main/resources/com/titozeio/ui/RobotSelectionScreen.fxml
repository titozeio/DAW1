<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.titozeio.ui.RobotSelectionScreen">
   <children>
      <ImageView fitHeight="720.0" fitWidth="1280.0" pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@../images/bg1.jpg" />
         </image>
      </ImageView>
      <VBox alignment="TOP_CENTER" spacing="18.0" stylesheets="@style.css">
         <padding>
            <Insets top="12.0" left="16.0" right="16.0" bottom="10.0" />
         </padding>
         <children>
            <Label text="SELECCION DE ROBOTS" textFill="WHITE" styleClass="scifi-panel" prefWidth="800.0" alignment="CENTER">
               <font>
                  <Font name="Exo 2 Regular" size="28.0" />
               </font>
               <padding>
                  <Insets top="8.0" bottom="8.0" />
               </padding>
            </Label>
            <HBox alignment="CENTER" spacing="12.0" prefHeight="410.0">
               <children>
                  <Button fx:id="prevRobotButton" onAction="#handlePrevRobotAction" text="&lt;" prefWidth="56.0" prefHeight="80.0" styleClass="scifi-button" />
                  <StackPane prefWidth="390.0" prefHeight="390.0" styleClass="scifi-panel">
                     <children>
                        <ImageView fx:id="conceptImageView" fitWidth="370.0" fitHeight="370.0" preserveRatio="true" />
                     </children>
                  </StackPane>
                  <VBox spacing="10.0" prefWidth="325.0">
                     <children>
                        <VBox prefHeight="220.0" spacing="8.0" styleClass="scifi-panel">
                           <padding><Insets top="8.0" left="10.0" right="10.0" bottom="8.0"/></padding>
                           <children>
                              <Label text="STATS" textFill="#7AEBF1">
                                 <font><Font name="Exo 2 Regular" size="24.0" /></font>
                              </Label>
                              <HBox alignment="CENTER_LEFT" spacing="8.0"><children><Label text="HP:" textFill="#7AEBF1"><font><Font size="18.0" /></font></Label><Label fx:id="statHpValueLabel" textFill="WHITE"><font><Font size="18.0" /></font></Label></children></HBox>
                              <HBox alignment="CENTER_LEFT" spacing="8.0"><children><Label text="Movimiento:" textFill="#7AEBF1"><font><Font size="18.0" /></font></Label><Label fx:id="statMoveValueLabel" textFill="WHITE"><font><Font size="18.0" /></font></Label></children></HBox>
                              <HBox alignment="CENTER_LEFT" spacing="8.0"><children><Label text="Danio:" textFill="#7AEBF1"><font><Font size="18.0" /></font></Label><Label fx:id="statDamageValueLabel" textFill="WHITE"><font><Font size="18.0" /></font></Label></children></HBox>
                              <HBox alignment="CENTER_LEFT" spacing="8.0"><children><Label text="Alcance:" textFill="#7AEBF1"><font><Font size="18.0" /></font></Label><Label fx:id="statRangeValueLabel" textFill="WHITE"><font><Font size="18.0" /></font></Label></children></HBox>
                           </children>
                        </VBox>
                        <VBox prefHeight="230.0" spacing="8.0" styleClass="scifi-panel">
                           <padding><Insets top="8.0" left="10.0" right="10.0" bottom="8.0"/></padding>
                           <children>
                              <Label fx:id="skillTitleLabel" textFill="#7AEBF1" wrapText="true">
                                 <font><Font name="Exo 2 Regular" size="24.0" /></font>
                              </Label>
                              <HBox alignment="CENTER_LEFT" spacing="8.0"><children><Label text="Tipo:" textFill="#7AEBF1"><font><Font size="18.0" /></font></Label><Label fx:id="skillTypeValueLabel" textFill="WHITE"><font><Font size="18.0" /></font></Label></children></HBox>
                              <HBox alignment="CENTER_LEFT" spacing="8.0"><children><Label text="Cooldown:" textFill="#7AEBF1"><font><Font size="18.0" /></font></Label><Label fx:id="skillCooldownValueLabel" textFill="WHITE"><font><Font size="18.0" /></font></Label></children></HBox>
                              <Label fx:id="skillStatsValueLabel" textFill="WHITE" wrapText="true">
                                 <font><Font size="18.0" /></font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  <VBox prefWidth="450.0" prefHeight="390.0" spacing="10.0" styleClass="scifi-panel">
                     <padding><Insets top="8.0" left="10.0" right="10.0" bottom="8.0"/></padding>
                     <children>
                        <Label text="INFO" textFill="#7AEBF1">
                           <font><Font name="Exo 2 Regular" size="24.0" /></font>
                        </Label>
                        <Label text="Robot:" textFill="#7AEBF1"><font><Font size="18.0" /></font></Label>
                        <Label fx:id="descRobotLabel" textFill="WHITE" wrapText="true"><font><Font size="16.0" /></font></Label>
                        <Label text="Arma:" textFill="#7AEBF1"><font><Font size="18.0" /></font></Label>
                        <Label fx:id="descWeaponLabel" textFill="WHITE" wrapText="true"><font><Font size="16.0" /></font></Label>
                        <Label text="Skill:" textFill="#7AEBF1"><font><Font size="18.0" /></font></Label>
                        <Label fx:id="descSkillLabel" textFill="WHITE" wrapText="true"><font><Font size="16.0" /></font></Label>
                     </children>
                  </VBox>
                  <Button fx:id="nextRobotButton" onAction="#handleNextRobotAction" text="&gt;" prefWidth="56.0" prefHeight="80.0" styleClass="scifi-button" />
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="16.0">
               <children>
                  <Button fx:id="confirmButton" onAction="#handleConfirmAction" text="Confirmar seleccion" prefWidth="320.0" prefHeight="94.0" styleClass="scifi-button" />
                  <Button fx:id="randomFinishButton" onAction="#handleSkipAction" text="Terminar al azar" prefWidth="320.0" prefHeight="94.0" styleClass="scifi-button-outline" />
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="20.0" prefHeight="170.0">
               <children>
                  <VBox prefWidth="430.0" spacing="8.0" styleClass="scifi-panel">
                     <padding><Insets top="8.0" left="10.0" right="10.0" bottom="8.0"/></padding>
                     <children>
                        <Label text="Jugador 1" textFill="#7AEBF1"><font><Font size="18.0" /></font></Label>
                        <HBox alignment="CENTER_LEFT" spacing="52.0">
                           <padding><Insets left="20.0" right="25.0"/></padding>
                           <children>
                              <VBox alignment="CENTER" spacing="6.0"><children><StackPane fx:id="p1Slot1Frame" prefWidth="90.0" prefHeight="90.0" style="-fx-background-color: rgba(128,128,128,0.3); -fx-border-color: #6CFDF6; -fx-border-width: 1;"><children><ImageView fx:id="p1Slot1Image" fitWidth="82.0" fitHeight="82.0" preserveRatio="true"/></children></StackPane><Label fx:id="p1Slot1Name" text="---" textFill="#C9D4DB"/></children></VBox>
                              <VBox alignment="CENTER" spacing="6.0"><children><StackPane fx:id="p1Slot2Frame" prefWidth="90.0" prefHeight="90.0" style="-fx-background-color: rgba(128,128,128,0.3); -fx-border-color: #6CFDF6; -fx-border-width: 1;"><children><ImageView fx:id="p1Slot2Image" fitWidth="82.0" fitHeight="82.0" preserveRatio="true"/></children></StackPane><Label fx:id="p1Slot2Name" text="---" textFill="#C9D4DB"/></children></VBox>
                              <VBox alignment="CENTER" spacing="6.0"><children><StackPane fx:id="p1Slot3Frame" prefWidth="90.0" prefHeight="90.0" style="-fx-background-color: rgba(128,128,128,0.3); -fx-border-color: #6CFDF6; -fx-border-width: 1;"><children><ImageView fx:id="p1Slot3Image" fitWidth="82.0" fitHeight="82.0" preserveRatio="true"/></children></StackPane><Label fx:id="p1Slot3Name" text="---" textFill="#C9D4DB"/></children></VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <VBox prefWidth="430.0" spacing="8.0" styleClass="scifi-panel">
                     <padding><Insets top="8.0" left="10.0" right="10.0" bottom="8.0"/></padding>
                     <children>
                        <Label text="Jugador 2" textFill="#7AEBF1"><font><Font size="18.0" /></font></Label>
                        <HBox alignment="CENTER_LEFT" spacing="52.0">
                           <padding><Insets left="20.0" right="25.0"/></padding>
                           <children>
                              <VBox alignment="CENTER" spacing="6.0"><children><StackPane fx:id="p2Slot1Frame" prefWidth="90.0" prefHeight="90.0" style="-fx-background-color: rgba(128,128,128,0.3); -fx-border-color: #6CFDF6; -fx-border-width: 1;"><children><ImageView fx:id="p2Slot1Image" fitWidth="82.0" fitHeight="82.0" preserveRatio="true"/></children></StackPane><Label fx:id="p2Slot1Name" text="---" textFill="#C9D4DB"/></children></VBox>
                              <VBox alignment="CENTER" spacing="6.0"><children><StackPane fx:id="p2Slot2Frame" prefWidth="90.0" prefHeight="90.0" style="-fx-background-color: rgba(128,128,128,0.3); -fx-border-color: #6CFDF6; -fx-border-width: 1;"><children><ImageView fx:id="p2Slot2Image" fitWidth="82.0" fitHeight="82.0" preserveRatio="true"/></children></StackPane><Label fx:id="p2Slot2Name" text="---" textFill="#C9D4DB"/></children></VBox>
                              <VBox alignment="CENTER" spacing="6.0"><children><StackPane fx:id="p2Slot3Frame" prefWidth="90.0" prefHeight="90.0" style="-fx-background-color: rgba(128,128,128,0.3); -fx-border-color: #6CFDF6; -fx-border-width: 1;"><children><ImageView fx:id="p2Slot3Image" fitWidth="82.0" fitHeight="82.0" preserveRatio="true"/></children></StackPane><Label fx:id="p2Slot3Name" text="---" textFill="#C9D4DB"/></children></VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
      <StackPane fx:id="turnOverlay" visible="false" managed="false" style="-fx-background-color: rgba(0,0,0,0.85);" onMouseClicked="#handleDismissTurnOverlay">
         <children>
            <VBox alignment="CENTER" spacing="12.0" styleClass="scifi-panel" minWidth="520.0" prefWidth="520.0" maxWidth="520.0" minHeight="140.0" prefHeight="140.0" maxHeight="140.0">
               <children>
                  <Label fx:id="turnOverlayLabel" textFill="#EAFBFF">
                     <font><Font name="Exo 2 Regular" size="26.0" /></font>
                  </Label>
                  <Label text="Click para continuar" textFill="#C9D4DB" />
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</StackPane>
