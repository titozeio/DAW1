<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.titozeio.ui.MainMenuScreen">
   <children>
      <ImageView fitHeight="720.0" fitWidth="1280.0" pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@../images/mainmenu.jpg" />
         </image>
      </ImageView>

      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="500.0" prefWidth="800.0" spacing="110.0">
         <children>
            <ImageView fx:id="titleImageView" fitWidth="600.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/title_transparent.png" />
               </image>
            </ImageView>

            <VBox alignment="CENTER" spacing="20.0">
               <children>
                  <Button fx:id="playButton" maxHeight="56.0" maxWidth="320.0" minHeight="56.0" minWidth="320.0" mnemonicParsing="false" onAction="#handlePlayAction" prefHeight="56.0" prefWidth="320.0" styleClass="scifi-button" text="Play">
                     <font>
                        <Font name="Exo 2 Regular" size="24.0" />
                     </font>
                  </Button>
                  <Button fx:id="playVsAiButton" maxHeight="56.0" maxWidth="320.0" minHeight="56.0" minWidth="320.0" mnemonicParsing="false" onAction="#handlePlayVsAiAction" prefHeight="56.0" prefWidth="320.0" styleClass="scifi-button" text="Play vs AI">
                     <font>
                        <Font name="Exo 2 Regular" size="24.0" />
                     </font>
                  </Button>
                  <Button fx:id="settingsButton" maxHeight="56.0" maxWidth="320.0" minHeight="56.0" minWidth="320.0" mnemonicParsing="false" onAction="#handleSettingsOpenAction" prefHeight="56.0" prefWidth="320.0" styleClass="scifi-button-outline" text="Settings">
                     <font>
                        <Font name="Exo 2 Regular" size="22.0" />
                     </font>
                  </Button>
                  <Button fx:id="helpButton" maxHeight="56.0" maxWidth="320.0" minHeight="56.0" minWidth="320.0" mnemonicParsing="false" onAction="#handleTutorialOpenAction" prefHeight="56.0" prefWidth="320.0" styleClass="scifi-button-outline" text="How to Play">
                     <font>
                        <Font name="Exo 2 Regular" size="22.0" />
                     </font>
                  </Button>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
         </padding>
      </VBox>

      <fx:include fx:id="settingsOverlayComponent" source="SettingsOverlay.fxml" />
      <fx:include fx:id="tutorialOverlayComponent" source="TutorialOverlay.fxml" />
   </children>
</StackPane>
