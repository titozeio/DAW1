<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.titozeio.ui.MainMenuScreen">
   <children>
      <ImageView fitHeight="720.0" fitWidth="1280.0" pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@../images/Splash%20concept.png" />
         </image>
      </ImageView>

      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="500.0" prefWidth="800.0" spacing="110.0">
         <children>
            <ImageView fx:id="titleImageView" fitWidth="600.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/title_transparent.png" />
               </image>
            </ImageView>

            <VBox alignment="CENTER" spacing="20.0">
               <children>
                  <Button fx:id="playButton" maxHeight="56.0" maxWidth="320.0" minHeight="56.0" minWidth="320.0" mnemonicParsing="false" onAction="#handlePlayAction" prefHeight="56.0" prefWidth="320.0" styleClass="scifi-button" text="Play">
                     <font>
                        <Font name="Exo 2 Regular" size="24.0" />
                     </font>
                  </Button>
                  <Button fx:id="settingsButton" maxHeight="56.0" maxWidth="320.0" minHeight="56.0" minWidth="320.0" mnemonicParsing="false" onAction="#handleSettingsOpenAction" prefHeight="56.0" prefWidth="320.0" styleClass="scifi-button-outline" text="Settings">
                     <font>
                        <Font name="Exo 2 Regular" size="22.0" />
                     </font>
                  </Button>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
         </padding>
      </VBox>

      <StackPane fx:id="settingsOverlay" alignment="CENTER" managed="false" style="-fx-background-color: rgba(0,0,0,0.9);" visible="false">
         <children>
            <VBox alignment="TOP_LEFT" maxHeight="180.0" maxWidth="360.0" minHeight="180.0" minWidth="360.0" prefHeight="180.0" prefWidth="360.0" spacing="22.0" styleClass="scifi-panel">
               <padding>
                  <Insets bottom="24.0" left="24.0" right="24.0" top="18.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label text="Settings" textFill="WHITE">
                           <font>
                              <Font name="Exo 2 Regular" size="24.0" />
                           </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handleSettingsCloseAction" prefHeight="30.0" prefWidth="30.0" styleClass="scifi-button-outline" text="X" />
                     </children>
                  </HBox>

                  <HBox alignment="CENTER_LEFT" spacing="14.0">
                     <children>
                        <Label text="Music" textFill="#C9D4DB">
                           <font>
                              <Font name="Exo 2 Regular" size="18.0" />
                           </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <CheckBox fx:id="musicToggle" mnemonicParsing="false" onAction="#handleMusicToggleAction" selected="true" text="ON" textFill="#4EE2C9" />
                     </children>
                  </HBox>

                  <HBox alignment="CENTER_LEFT" spacing="14.0">
                     <children>
                        <Label text="SFX" textFill="#C9D4DB">
                           <font>
                              <Font name="Exo 2 Regular" size="18.0" />
                           </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <CheckBox fx:id="sfxToggle" mnemonicParsing="false" onAction="#handleSfxToggleAction" selected="true" text="ON" textFill="#4EE2C9" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</StackPane>
