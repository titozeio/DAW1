<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="settingsOverlay" alignment="CENTER" managed="false" style="-fx-background-color: rgba(0,0,0,0.9);" visible="false" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.titozeio.ui.SettingsOverlayController">
   <children>
      <VBox alignment="TOP_LEFT" maxHeight="180.0" maxWidth="360.0" minHeight="180.0" minWidth="360.0" prefHeight="180.0" prefWidth="360.0" spacing="22.0" styleClass="scifi-panel">
         <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="18.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label text="Settings" textFill="WHITE">
                     <font>
                        <Font name="Exo 2 Regular" size="24.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#handleSettingsCloseAction" prefHeight="30.0" prefWidth="30.0" styleClass="scifi-button-outline" text="X" />
               </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="14.0">
               <children>
                  <Label styleClass="scifi-label-cyan" text="Music" textFill="#57C0EF">
                     <font>
                        <Font name="Exo 2 Regular" size="18.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <CheckBox fx:id="musicToggle" minWidth="65.0" mnemonicParsing="false" onAction="#handleMusicToggleAction" prefWidth="65.0" selected="true" styleClass="scifi-checkbox" text="ON" />
               </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="14.0">
               <children>
                  <Label styleClass="scifi-label-cyan" text="SFX" textFill="#57C0EF">
                     <font>
                        <Font name="Exo 2 Regular" size="18.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <CheckBox fx:id="sfxToggle" minWidth="65.0" mnemonicParsing="false" onAction="#handleSfxToggleAction" prefWidth="65.0" selected="true" styleClass="scifi-checkbox" text="ON" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>

