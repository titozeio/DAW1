<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="tutorialOverlay" alignment="CENTER" managed="false" style="-fx-background-color: rgba(0,0,0,0.92);" visible="false" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.titozeio.ui.TutorialOverlayController">
   <children>
      <VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" spacing="18.0" styleClass="scifi-panel">
         <padding>
            <Insets bottom="30.0" left="40.0" right="40.0" top="20.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label text="MANUAL DE OPERACIONES TÁCTICAS" textFill="#57C0EF">
                     <font>
                        <Font name="Exo 2 Bold" size="26.0" />
                     </font>
                  </Label>
                  <Region minWidth="60.0" HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#close" prefHeight="36.0" prefWidth="36.0" styleClass="scifi-button-outline" text="X" />
               </children>
            </HBox>
            <VBox spacing="10.0" alignment="TOP_LEFT" maxWidth="820.0">
               <children>
                  <Label text="1. DESPLIEGUE" textFill="#57C0EF" style="-fx-font-weight: bold;"><font><Font size="18.0"/></font></Label>
                  <Label text="Selecciona 3 robots. J2 elige primero. Posiciónalos en las zonas resaltadas de tu borde del mapa." textFill="#D6DCE0" wrapText="true" />
                  
                  <Label text="2. ACCIONES Y MODOS" textFill="#57C0EF" style="-fx-font-weight: bold;"><font><Font size="18.0"/></font></Label>
                  <Label text="Cada robot tiene 2 acciones: MOVER y ATACAR. Haz clic en tu robot para alternar modos (Verde ➔ Naranja ➔ Morado para Habilidad)." textFill="#D6DCE0" wrapText="true" />
                  
                  <Label text="3. INTELIGENCIA DE CAMPO (PANELES)" textFill="#57C0EF" style="-fx-font-weight: bold;"><font><Font size="18.0"/></font></Label>
                  <Label text="Usa el PANEL DE INFO (abajo izquierda) para ver estadísticas detalladas, HPs y cooldowns de habilidades. Revisa el COMBAT LOG (abajo centro) para un registro histórico de daños, ataques y eventos críticos." textFill="#D6DCE0" wrapText="true" />
                  
                  <Label text="4. TERRENO Y VENTAJA" textFill="#57C0EF" style="-fx-font-weight: bold;"><font><Font size="18.0"/></font></Label>
                  <Label text="La altura y el bosque proporcionan cobertura defensiva. El agua poco profunda potencia el daño infligido pero aumenta drásticamente tu vulnerabilidad." textFill="#D6DCE0" wrapText="true" />
                  
                  <Label text="MISIONES DE VICTORIA" textFill="#FF9E57" style="-fx-font-weight: bold;"><font><Font size="18.0"/></font></Label>
                  <Label text="● Destruye todas las unidades enemigas en el campo de batalla.&#10;● Captura la base rival (casilla central enemiga) y resiste allí 2 turnos." textFill="#D6DCE0" wrapText="true" />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</StackPane>
